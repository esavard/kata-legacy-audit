<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <!-- writes straight into wwwroot/logs, which UseStaticFiles() serves to anyone -
       see Startup.cs. ConversionPattern dumps full exception detail including
       (via the custom %property{requestbody} used in Controllers) raw request
       bodies, so a failed login attempt's payload, a failed SQL query, and stack
       traces all end up in a plaintext file anyone can request directly:
       /logs/app.log -->
  <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
    <file value="wwwroot/logs/app.log" />
    <appendToFile value="true" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%property{requestbody}%newline%exception" />
    </layout>
  </appender>

  <root>
    <level value="ALL" />
    <appender-ref ref="RollingFile" />
  </root>
</log4net>
